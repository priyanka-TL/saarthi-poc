# ==========================================
# LLM Configuration (LiteLLM -> OpenRouter)
# ==========================================
# All LLM calls go through LiteLLM, which routes requests to OpenRouter.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Any model id available on OpenRouter (https://openrouter.ai/models).
OPENROUTER_MODEL=qwen/qwen3.7-flash

# Per-request timeout (seconds) and retry count, applied by LiteLLM to every LLM call.
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# ==========================================
# Application Settings
# ==========================================
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
