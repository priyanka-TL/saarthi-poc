# ---- core ----------------------------------------------------------------
SAARTHI_ENV=development
LOG_LEVEL=INFO
SAARTHI_SECRET_KEY=change-me

# ---- database ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://saarthi:saarthi@localhost:5433/saarthi
DB_POOL_SIZE=16                 # must be >= gunicorn --threads
DB_MAX_OVERFLOW=8

# ---- auth / jwt ----
SAARTHI_JWT_SECRET=
SAARTHI_JWT_VERIFY_EXP=true
SAARTHI_STATIC_TOKEN=
JWT_IDENTIFIER_FIELD=id
JWT_EMAIL_SUFFIX=@shikshalokam.org
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# ---- registry ------------------------------------------------------------
SAARTHI_CONFIG_SYNC_MODE=safe   # safe | force | off
SAARTHI_REGISTRY_TTL_S=30

# ---- identity — ONE token is the single source (§9.5) --------------------
# The token IS the identity. Everything below is DERIVED from its claims:
# user_id, display_name, tenant_code, organizations, roles, and the email.
# Nothing about the user is configured separately, so nothing can drift out
# of sync with the token.
SAARTHI_USER_PROVIDER=static_token      # static_token | request_token
SAARTHI_USER_TOKEN=<paste the platform JWT>
SAARTHI_ACTIVE_ORG_ID=                  # optional; defaults to organization_ids[0]
SAARTHI_DEFAULT_LOCALE=en

# The same token is forwarded verbatim as `Authorization: Bearer` to
# /api/end-story/v2/ — there is no second credential to keep aligned.

# ---- email derivation — MUST match mitra's SSO path exactly (§1.7 trap 1) -
# mitra derives: email = data[JWT_IDENTIFIER_FIELD] + JWT_EMAIL_SUFFIX
# The mitra default identifier field is 'userId', which this token does NOT
# carry — the field is 'id'. Getting this wrong creates a SECOND profile for
# the same person and splits their stories across two identities.
JWT_IDENTIFIER_FIELD=id                 # NOT the 'userId' default — see §1.7
JWT_EMAIL_SUFFIX=@shikshalokam.org      # -> 1355@shikshalokam.org

# Signature verification on Saarthi's own edge. Leave the secret unset in the
# POC to decode without verifying; REQUIRED before any network exposure.
SAARTHI_JWT_SECRET=
SAARTHI_JWT_ALGORITHM=HS256
SAARTHI_JWT_VERIFY_EXP=true             # the sample token has a 7-day lifetime

# ---- mitra relay ---------------------------------------------------------
MITRA_ENABLED=1                 # 0 disables all remote_flow agents
MITRA_BASE_URL=https://<mitra-host>
MITRA_WS_URL=wss://<mitra-host>/ws/common/
MITRA_ORIGIN_URL=https://<allowlisted-origin>     # mitra gates on Origin — §13.2
MITRA_USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) …
MITRA_COMPANY=<company-slug>    # mitra Company.slug — NOT tenant_code (§1.7 trap 2).
                                # Referenced per agent via remote.company_env.
MITRA_STORY_BOT_ROUTE=/<verify against deployed CompanyBot.route — §1.6>
MITRA_DISCUSSION_BOT_ROUTE=/<verify against deployed CompanyBot.route>
# Comma-separated extra hosts get_report() may return presigned URLs on. The
# MITRA_BASE_URL host is trusted implicitly; the report CDN/static host usually
# is NOT the same host, and omitting it fails _validate_url on every report.
MITRA_ALLOWED_HOSTS=<report-static-host>
MITRA_IP_CITY=Bengaluru
MITRA_IP_STATE=Karnataka
MITRA_IP_ZIP=562130
MITRA_WS_CONNECT_TIMEOUT_S=10
MITRA_MAX_OPEN_CHANNELS=200
MITRA_IDLE_CLOSE_S=1200
SESSION_ABANDON_AFTER_S=604800

# ---- feature flags -------------------------------------------------------
SAARTHI_PERSISTENCE=postgres    # postgres | memory   (P1 kill switch)
SAARTHI_REGISTRY=config         # config | code       (P2 kill switch)
SAARTHI_ROUTER=v2               # v2 | v1            (P3 kill switch)
SAARTHI_ADMIN_ENABLED=0         # P5 kill switch
